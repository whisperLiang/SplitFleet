+def _iter_tinygrad_public_attrs(module: Any, address: str) -> Iterator[tuple[str, Any]]:
+    """Yield public attributes through state containers, preserving alias paths.
+
+    Containers are address components, not callable modules. Guard ancestors
+    per path so recursive containers terminate while shared state keeps every
+    address. Arbitrary objects are leaves and are never introspected here.
+    """
+
+    stack = [
+        (_join_module_address(address, name), value, frozenset())
+        for name, value in reversed(tuple(getattr(module, "__dict__", {}).items()))
+        if not name.startswith("_")
+    ]
+    while stack:
+        path, value, ancestors = stack.pop()
+        if hasattr(value, "_asdict"):
+            children = tuple(value._asdict().items())
+        elif isinstance(value, Mapping):
+            children = tuple(value.items())
+        elif isinstance(value, (list, tuple)):
+            children = tuple(enumerate(value))
+        else:
+            yield path, value
+            continue
+        if id(value) in ancestors:
+            continue
+        ancestors = ancestors | {id(value)}
+        stack.extend(
+            (_join_module_address(path, str(key)), child, ancestors)
+            for key, child in reversed(children)
         )
 
 
