+        SHA-256 Merkle signature of operation, dtype, arg, and ordered sources.
+        Structurally identical graphs match independently of object sharing.
+
+    Notes
+    -----
+    Iterative postorder traversal hashes each reachable UOp once per call, so
+    shared subgraphs take O(V + E) work and deep graphs do not use recursion.
+    The identity memo is local: no graph objects or stale signatures survive
+    the call. Length-prefixed metadata and fixed-size child digests keep fields
+    and operand positions unambiguous.
+    """
+
+    digests: dict[int, bytes] = {}
+    stack = [(uop, False)]
+    while stack:
+        node, expanded = stack.pop()
+        node_id = id(node)
+        if node_id in digests:
+            continue
+        sources = tuple(getattr(node, "src", ()) or ())
+        if not expanded:
+            stack.append((node, True))
+            stack.extend((source, False) for source in reversed(sources))
+            continue
+
+        digest = sha256(b"torchlens.tinygrad.uop.v1\0")
+        for field in (
+            _uop_name(node),
+            str(getattr(node, "dtype", None)),
+            str(getattr(node, "arg", None)),
+        ):
+            encoded = field.encode("utf-8")
+            digest.update(len(encoded).to_bytes(8, "big"))
+            digest.update(encoded)
+        digest.update(len(sources).to_bytes(8, "big"))
+        for source in sources:
+            digest.update(digests[id(source)])
+        digests[node_id] = digest.digest()
+
+    return "sha256:" + digests[id(uop)].hex()
 
 
